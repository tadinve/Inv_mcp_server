# Copy to .env for local use. Never commit .env.

# Authentication mode: "dev" (TEST-ONLY, loopback only, refused on Cloud Run) or "google".
INVENTORY_AUTH_MODE=dev

# Google mode only: expected token audience, an https URL (usually the Cloud Run service URL).
# INVENTORY_OIDC_AUDIENCE=https://SERVICE-PROJECT_NUMBER.REGION.run.app

# Dev mode only: allow a non-loopback bind for a LOCAL container. Never set this on Cloud Run.
# INVENTORY_DEV_ALLOW_NON_LOOPBACK=true

# Permission policy: maps verified subjects to inventory.read / restock.create.
# Google mode: start from config/policy.example.json.
INVENTORY_POLICY_PATH=config/policy.dev.json

# SQLite file for restock requests (created if missing).
INVENTORY_DB_PATH=var/restock_requests.db

# Bind address and port. Cloud Run sets PORT; the container will bind 0.0.0.0.
INVENTORY_HOST=127.0.0.1
PORT=8000

# Optional: comma-separated allowed Host headers (DNS-rebinding protection) for non-loopback binds.
# INVENTORY_ALLOWED_HOSTS=

INVENTORY_LOG_LEVEL=INFO
